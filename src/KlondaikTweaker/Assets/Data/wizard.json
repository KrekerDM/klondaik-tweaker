ng и встроенные медиаприложения","hen":"Bing and bundled media apps"},{"id":"none","ru":"Ничего не трогать","en":"Leave them alone"}]}],"rules":[{"when":"use=gaming","add":["game.gamedvr-off","game.gamebar-off","game.gamemode-on","perf.priority-separation","perf.system-responsiveness","perf.network-throttling","perf.games-task","perf.mouse-accel","perf.keyboard-speed","pwr.high-performance","net.tcp-tuning","net.qos-off","net.dns-cache","ui.sticky-keys-off","perf.fast-startup-off"],"drop":[]},{"when":"games=competitive","add":["game.fso-off","gpu.hags-on","perf.paging-executive","pwr.core-parking-off","pwr.usb-suspend-off","svc.netdata-off","perf.power-throttling-off"],"drop":[]},{"when":"games=aaa","add":["gpu.hags-on","gpu.tdr-delay","perf.power-throttling-off"],"drop":[]},{"when":"use=dev","add":["perf.svchost-split","perf.paging-executive"],"drop":["perf.8dot3-off"]},{"when":"use=media","add":["pwr.disk-timeout-off"],"drop":[]},{"when":"privacy=max","add":["priv.telemetry-off","priv.diagtrack-off","priv.typing-off","priv.speech-off","priv.sync-off","priv.cloud-clipboard-off","priv.edge-telemetry","priv.delivery-optimization","priv.location-off","priv.hosts-telemetry","priv.background-apps-off","ai.bing-search-off","ai.cortana-off","ai.copilot-off","ai.recall-off","ui.recent-off","disk.storage-sense-off","net.llmnr-off","net.wifi-sense-off"],"drop":[]},{"when":"privacy=balanced","add":["priv.telemetry-off","priv.diagtrack-off","priv.edge-telemetry","priv.delivery-optimization","priv.sync-off","ai.bing-search-off","ai.copilot-off","ai.recall-off","net.llmnr-off"],"drop":[]},{"when":"defender=off","add":["sec.defender-off","sec.smartscreen-off"],"drop":[]},{"when":"defender=other","add":["sec.smartscreen-off"],"drop":[]},{"when":"updates=auto","add":["upd.no-auto-restart"],"drop":[]},{"when":"updates=manual","add":["upd.manual","upd.no-driver-updates","upd.no-auto-restart","upd.store-auto-off"],"drop":[]},{"when":"updates=off","add":["upd.full-off","upd.no-driver-updates"],"drop":[]},{"when":"printer=no","add":["svc.print-off"],"drop":[]},{"when":"bluetooth=no","add":["svc.bluetooth-off"],"drop":[]},{"when":"xbox=no","add":["game.xbox-services-off","app.debloat-xbox"],"drop":[]},{"when":"hello=password","add":["svc.smartcard-off"],"drop":[]},{"when":"onedrive=no","add":["ui.onedrive-hide"],"drop":[]},{"when":"search=no","add":["perf.search-index-off"],"drop":[]},{"when":"ui=taskbar","add":["ui.taskbar-clean"],"drop":[]},{"when":"ui=left","add":["ui.taskbar-left"],"drop":[]},{"when":"ui=classic","add":["ui.classic-context"],"drop":[]},{"when":"ui=start","add":["ui.start-recommend-off"],"drop":[]},{"when":"ui=dark","add":["ui.dark-mode"],"drop":[]},{"when":"ui=anim","add":["ui.animations-off","ui.transparency-off","ui.snap-suggestions-off"],"drop":[]},{"when":"cleanup=aggressive","add":["app.debloat-bing","app.debloat-social","app.debloat-media","app.debloat-ai"],"drop":[]},{"when":"cleanup=light","add":["app.debloat-bing","app.debloat-media"],"drop":[]},{"when":"disk=ssd","add":["perf.sysmain-off","perf.prefetch-off","disk.defrag-ssd-off","disk.trim-on"],"drop":[]},{"when":"disk=hdd","add":["pwr.disk-timeout-off"],"drop":["perf.sysmain-off","perf.prefetch-off"]},{"when":"gpu=nvidia","add":["gpu.nvidia-telemetry"],"drop":[]},{"when":"device=desktop","add":["pwr.ultimate","svc.touch-off"],"drop":[]},{"when":"device=laptop","add":[],"drop":["perf.power-throttling-off","pwr.ultimate","perf.dynamic-tick-off","pwr.core-parking-off","svc.touch-off"]},{"when":"risk=medium","add":["svc.legacy-off","svc.diagnostics-off","svc.insider-off","svc.remote-off","perf.fast-startup-off","perf.svchost-split"],"drop":[]},{"when":"risk=max","add":["svc.legacy-off","svc.diagnostics-off","svc.insider-off","svc.remote-off","perf.fast-startup-off","perf.svchost-split","perf.mitigations-off","sec.vbs-off","perf.mem-compression-off","perf.8dot3-off","disk.reserved-storage-off"],"drop":[]},{"when":"risk=safe","add":[],"drop":["sec.vbs-off","sec.defender-o